{
  "name": "ShareLink",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "title": "Token"
    },
    "owner_id": {
      "type": "string",
      "title": "Owner ID"
    },
    "area": {
      "type": "string",
      "enum": [
        "school",
        "work",
        "personal",
        "shareable"
      ],
      "default": "shareable",
      "title": "Area"
    },
    "mode": {
      "type": "string",
      "enum": [
        "view",
        "edit"
      ],
      "default": "view",
      "title": "Mode"
    },
    "editors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Editors"
    }
  },
  "required": [
    "token",
    "owner_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
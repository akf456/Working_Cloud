{
  "name": "TrashItem",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "Task",
        "Event",
        "Course",
        "Contact"
      ],
      "title": "Entity Type"
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "snapshot": {
      "type": "string",
      "title": "Snapshot"
    },
    "deleted_date": {
      "type": "string",
      "format": "date-time",
      "title": "Deleted Date"
    },
    "area": {
      "type": "string",
      "enum": [
        "school",
        "work",
        "personal",
        "shareable"
      ],
      "default": "school",
      "title": "Area"
    }
  },
  "required": [
    "entity_type",
    "name",
    "snapshot"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
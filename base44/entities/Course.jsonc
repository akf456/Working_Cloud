{
  "name": "Course",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Course Name"
    },
    "code": {
      "type": "string",
      "title": "Course Code"
    },
    "color": {
      "type": "string",
      "title": "Color",
      "default": "#6366f1"
    },
    "instructor": {
      "type": "string",
      "title": "Instructor"
    },
    "semester": {
      "type": "string",
      "title": "Semester"
    },
    "syllabus_url": {
      "type": "string",
      "title": "Syllabus URL"
    }
  },
  "required": [
    "name"
  ]
}
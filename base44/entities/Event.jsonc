{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "title": "Start"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "title": "End"
    },
    "all_day": {
      "type": "boolean",
      "default": false,
      "title": "All Day"
    },
    "type": {
      "type": "string",
      "enum": [
        "exam",
        "deadline",
        "class",
        "study",
        "event",
        "holiday"
      ],
      "default": "event",
      "title": "Type"
    },
    "course_id": {
      "type": "string",
      "title": "Course ID"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "syllabus"
      ],
      "default": "manual",
      "title": "Source"
    },
    "repeat": {
      "type": "string",
      "enum": [
        "none",
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "none",
      "title": "Repeat"
    },
    "repeat_days": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "title": "Repeat Days"
    },
    "repeat_start_date": {
      "type": "string",
      "format": "date-time",
      "title": "Repeat Start"
    },
    "repeat_end_date": {
      "type": "string",
      "format": "date-time",
      "title": "Repeat End"
    },
    "flag": {
      "type": "string",
      "title": "Flag"
    },
    "area": {
      "type": "string",
      "enum": [
        "school",
        "work",
        "personal",
        "shareable"
      ],
      "default": "school",
      "title": "Area"
    }
  },
  "required": [
    "title",
    "start_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
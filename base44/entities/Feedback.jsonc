{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "title": "Message"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "bug",
        "suggestion",
        "other"
      ],
      "default": "general",
      "title": "Category"
    },
    "from_name": {
      "type": "string",
      "title": "From Name"
    },
    "from_email": {
      "type": "string",
      "title": "From Email"
    }
  },
  "required": [
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
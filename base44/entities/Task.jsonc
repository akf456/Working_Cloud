{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "title": "Due Date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "title": "Priority"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "done"
      ],
      "default": "todo",
      "title": "Status"
    },
    "type": {
      "type": "string",
      "default": "misc",
      "title": "Type"
    },
    "course_id": {
      "type": "string",
      "title": "Course ID"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "syllabus"
      ],
      "default": "manual",
      "title": "Source"
    },
    "color": {
      "type": "string",
      "title": "Color"
    },
    "flag": {
      "type": "string",
      "title": "Flag"
    },
    "list_type": {
      "type": "string",
      "enum": [
        "task",
        "todo"
      ],
      "default": "task",
      "title": "List Type"
    },
    "repeat": {
      "type": "string",
      "enum": [
        "none",
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "none",
      "title": "Repeat"
    },
    "repeat_days": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "title": "Repeat Days"
    },
    "repeat_start_date": {
      "type": "string",
      "format": "date-time",
      "title": "Repeat Start"
    },
    "repeat_end_date": {
      "type": "string",
      "format": "date-time",
      "title": "Repeat End"
    },
    "completed_dates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Completed Dates"
    },
    "area": {
      "type": "string",
      "enum": [
        "school",
        "work",
        "personal",
        "shareable"
      ],
      "default": "school",
      "title": "Area"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}